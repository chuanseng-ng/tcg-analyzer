# Environment configuration for local development.
#
#   cp .env.example .env
#
# Copy this file to `.env` and edit that. `.env` is gitignored; this file is
# not, so it must never contain a working credential — every value below is a
# placeholder or a local-only default (spec §77: the project may be open
# sourced, so no secret may ever enter history).
#
# Every `TCG_API_*` variable here is read by `services/api/src/tcg_api/config.py`.
# The two are kept in step by `tests/test_environment_example.py`: adding a
# setting without documenting it here fails the suite.

# ---------------------------------------------------------------------------
# API — services/api
# ---------------------------------------------------------------------------

# Where PostgreSQL lives, as a SQLAlchemy URL. The driver must be asynchronous
# (`+asyncpg`); a synchronous one is rejected at startup.
#
# Unset is allowed: the API still starts, /health answers, and /readiness
# reports `database: unavailable`. That is what a fresh clone looks like before
# `docker compose -f infrastructure/local/docker-compose.yml up -d`.
#
# The credentials below match that Compose file's local-only defaults. They are
# not secrets and are not used anywhere else.
TCG_API_DATABASE_URL=postgresql+asyncpg://tcg:tcg@localhost:5432/tcg

# Root log level: DEBUG, INFO, WARNING, ERROR or CRITICAL.
TCG_API_LOG_LEVEL=INFO

# `json` for machine-readable deployment logs, `console` for readable local
# ones. Local development usually wants `console`.
TCG_API_LOG_FORMAT=console

# Browser origins allowed to call the API, as a JSON array. The default is the
# Next.js dev server; add your deployed web origin in a deployed environment.
TCG_API_CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------------------
# Web — apps/web
#
# `NEXT_PUBLIC_*` values are inlined into the browser bundle. Never put a secret
# in one. For a bare `pnpm --filter @tcg/web dev`, Next reads
# `apps/web/.env.local` rather than this file; this copy is what the Compose
# stack passes to the web container.
# ---------------------------------------------------------------------------

# Base URL of the FastAPI service, as reachable from the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
