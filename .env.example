# Environment configuration for local development.
#
#   cp .env.example .env
#
# Copy this file to `.env` and edit that. `.env` is gitignored; this file is
# not, so it must never contain a working credential — every value below is a
# placeholder or a local-only default (spec §77: the project may be open
# sourced, so no secret may ever enter history).
#
# Every `TCG_API_*` variable here is read by `services/api/src/tcg_api/config.py`.
# The two are kept in step by `tests/test_environment_example.py`: adding a
# setting without documenting it here fails the suite.

# ---------------------------------------------------------------------------
# API — services/api
# ---------------------------------------------------------------------------

# Where PostgreSQL lives, as a SQLAlchemy URL. The driver must be asynchronous
# (`+asyncpg`); a synchronous one is rejected at startup.
#
# Unset is allowed: the API still starts, /health answers, and /readiness
# reports `database: unavailable`. That is what a fresh clone looks like before
# `docker compose -f infrastructure/local/docker-compose.yml up -d`.
#
# The credentials below match that Compose file's local-only defaults. They are
# not secrets and are not used anywhere else.
TCG_API_DATABASE_URL=postgresql+asyncpg://tcg:tcg@localhost:5432/tcg

# Root log level: DEBUG, INFO, WARNING, ERROR or CRITICAL.
TCG_API_LOG_LEVEL=INFO

# `json` for machine-readable deployment logs, `console` for readable local
# ones. Local development usually wants `console`.
TCG_API_LOG_FORMAT=console

# Browser origins allowed to call the API, as a JSON array. The default is the
# Next.js dev server; add your deployed web origin in a deployed environment.
TCG_API_CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------------------
# Anonymous sessions — spec §53, §54
# ---------------------------------------------------------------------------

# How long an anonymous session, and every analysis and image hanging off it,
# is kept — seven days. This is the retention policy: `analysis_sessions.
# expires_at` has no server default precisely so the period lives somewhere a
# reviewer sees it. Shorten it if you would rather hold users' photographs for
# less time; nothing in the code assumes a particular value.
TCG_API_SESSION_TTL_SECONDS=604800

# Whether the session cookie is marked `Secure`. Off locally, because local
# development is plain http and a `Secure` cookie would never be sent at all.
# Turn it on wherever https terminates: the cookie is a bearer token, and
# without this a downgrade to http leaks it.
TCG_API_SESSION_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# The job queue — spec §8
# ---------------------------------------------------------------------------

# Where Redis lives. The API enqueues analysis runs here and the worker consumes
# them; #98's rate limiter will share the same instance.
#
# Unset is allowed, as with the database: the API still starts and only the
# endpoints that queue work answer 503. A *malformed* URL is fatal at startup.
#
# The password matches the Compose file's local-only default and is not a
# secret. IN A DEPLOYMENT USE `rediss://` WITH REAL CREDENTIALS — an
# unauthenticated broker reachable from anywhere lets an attacker enqueue tasks
# straight into the worker, which is the best-known way into this stack after
# pickle deserialization (which is why the worker accepts JSON and nothing else).
TCG_API_REDIS_URL=redis://:tcglocaldev@localhost:6379/0

# ---------------------------------------------------------------------------
# Rate limiting — spec §55
# ---------------------------------------------------------------------------

# How many requests one client may make to the endpoints spec §55 names — right
# now `POST /analyses` and `POST /analyses/{id}/run` — per window. Counted in
# the same Redis as the job queue above, so the limit holds across replicas.
#
# With TCG_API_REDIS_URL unset there is no limiting at all: the service starts
# and the endpoints answer as before. A throttled request gets 429 with a
# `Retry-After` header and is deliberately outside the spec §66 error envelope
# — see docs/adr/0005-rate-limiting-the-analysis-endpoints.md.
#
# Clients behind one address share a bucket. Raise this where an office or a
# mobile carrier NAT would otherwise count as one user.
TCG_API_RATE_LIMIT_REQUESTS=30
TCG_API_RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Object storage — S3-compatible, MinIO locally
#
# As with the database, unset is allowed: the API still starts and /readiness
# reports `storage: unavailable`. A *malformed* endpoint is fatal at startup.
#
# These credentials match the Compose file's local-only defaults. They are not
# secrets, and they are not used anywhere else. A real key belongs in `.env`,
# which is never committed.
# ---------------------------------------------------------------------------

# Where the S3-compatible store lives. Leave unset for real AWS S3, whose
# endpoint boto3 derives from the region.
TCG_API_STORAGE_ENDPOINT_URL=http://localhost:9000

# The bucket every storage key is relative to. The Compose file's MinIO
# service creates it on startup, so a fresh clone needs no setup step.
TCG_API_STORAGE_BUCKET=tcg-local

# The region to sign for. MinIO ignores it, but a v4 signature requires one.
TCG_API_STORAGE_REGION=us-east-1

TCG_API_STORAGE_ACCESS_KEY_ID=tcg
TCG_API_STORAGE_SECRET_ACCESS_KEY=tcglocaldev

# How long a signed URL stays valid, in seconds. Keep it short: a signed URL is
# a bearer credential nobody can revoke, so the only bound on its misuse is how
# quickly it stops working (spec §55).
TCG_API_STORAGE_SIGNED_URL_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# Published ports — infrastructure/local/docker-compose.yml
#
# Read by Compose, not by the application. These are the HOST ports the stack
# publishes; inside the Compose network the services always reach each other on
# the container port under the service name (`postgres:5432`, `minio:9000`),
# which is why changing these cannot break service-to-service traffic.
#
# Change one when something already owns the default. The API's CORS origin and
# the web app's API base URL are both derived from these, so the two stay
# consistent automatically.
# ---------------------------------------------------------------------------

API_PORT=8000
WEB_PORT=3000

# ---------------------------------------------------------------------------
# MinIO — infrastructure/local/docker-compose.yml
#
# Read by Compose, not by the API. They must agree with the TCG_API_STORAGE_*
# credentials above, since they are what MinIO is started with.
# ---------------------------------------------------------------------------

MINIO_ROOT_USER=tcg
MINIO_ROOT_PASSWORD=tcglocaldev
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------------------------------------------------------------------------
# Redis — infrastructure/local/docker-compose.yml
#
# Read by Compose, not by the API. REDIS_PASSWORD is what the container is
# started with, so it must agree with the password in TCG_API_REDIS_URL above.
# ---------------------------------------------------------------------------

REDIS_PASSWORD=tcglocaldev
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Web — apps/web
#
# `NEXT_PUBLIC_*` values are inlined into the browser bundle. Never put a secret
# in one. For a bare `pnpm --filter @tcg/web dev`, Next reads
# `apps/web/.env.local` rather than this file; this copy is what the Compose
# stack passes to the web container.
# ---------------------------------------------------------------------------

# Base URL of the FastAPI service, as reachable from the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
