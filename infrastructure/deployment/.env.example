# Environment for the production overlay — issue #273, ADR 0012.
#
#   cp infrastructure/deployment/.env.example infrastructure/deployment/.env
#
# Read by Compose through `--env-file infrastructure/deployment/.env`, never by
# default: without the flag Compose reads `infrastructure/local/.env`, the local
# stack's. Every value below is a placeholder. The overlay refuses to start
# while any required one is unset, so the local file's obvious defaults can
# never reach a host by omission.
#
# Generate each secret with `openssl rand -hex 32`. Hex, because two of them
# are spliced into URLs (the database and the broker), where `@`, `/` or `:`
# would silently change what the URL means.

# The one hostname the beta is served on. DNS for it points at this host, and
# Caddy obtains its certificate on first start. The web image is built for
# this value (Next inlines the API's URL at build time), so changing it is a
# rebuild, not a restart.
TCG_DOMAIN=beta.example.com

# PostgreSQL. Applied only when the data volume is first initialised: changing
# it later is an `ALTER ROLE`, not an edit here.
POSTGRES_PASSWORD=

# MinIO's root account. Used by `minio-init` to create the application's
# account, and by nothing else — neither the API nor the worker ever holds it.
# MinIO requires at least eight characters for each.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# The application's own MinIO account, scoped to the one bucket: read, write,
# delete and list objects in it, nothing else.
MINIO_APP_ACCESS_KEY=
MINIO_APP_SECRET_KEY=

# The broker's password. The broker speaks TLS only, with a certificate the
# stack generates on its first `up`.
REDIS_PASSWORD=

# Optional — the local file's defaults apply when unset.
# POSTGRES_USER=tcg
# POSTGRES_DB=tcg
# TCG_API_STORAGE_BUCKET=tcg-local
# TCG_API_LOG_LEVEL=INFO
